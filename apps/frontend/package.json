{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "build": "tsc -b && vite build",
    "test": "vitest run --coverage --maxWorkers=2",
    "lint": "oxlint && pnpm run lint:home",
    "preview": "vite preview",
    "lint:home": "eslint --config eslint.home.config.js src/pages/public/Home.tsx src/pages/public/home --max-warnings 0"
  },
  "dependencies": {
    "@fidelity/shared": "workspace:*",
    "@fontsource-variable/manrope": "^5.3.0",
    "@supabase/supabase-js": "^2.116.0",
    "html5-qrcode": "^2.3.8",
    "leaflet": "^1.9.4",
    "motion": "^14.0.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.12.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "jsdom": "^30.1.0",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  }
}
