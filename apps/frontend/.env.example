# URL y llave pública del proyecto Supabase.
# Local (pnpm run supabase:start): http://127.0.0.1:54321
# La anon key la imprime `npx supabase status`.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# URL del backend (Nest). Por defecto local: http://localhost:3000
VITE_API_URL=

# Si es 'true', fuerza el uso de mocks en el cliente (para desarrollo sin backend)
VITE_USE_MOCKS=

# Datos legales que muestra /terminos. Obligatorios antes de producción: sin ellos la página
# muestra un aviso de borrador.
VITE_LEGAL_COMPANY=
VITE_LEGAL_COMPANY_RUT=
VITE_LEGAL_ADDRESS=
VITE_LEGAL_CONTACT_EMAIL=

# Mockup de facturación (/admin/billing y banner de prueba). Solo 'true' lo activa: sin la
# variable la ruta y el menú no existen (HANDOFF §6.5).
VITE_FEATURE_BILLING=

# Canales de contacto de /admin/support. Sin valor, el canal no se muestra.
VITE_SUPPORT_EMAIL=
# Número en formato internacional, p. ej. +56912345678 (se usa en https://wa.me/).
VITE_SUPPORT_WHATSAPP=
