# URL y llave pública del proyecto Supabase.
# Local (pnpm run supabase:start): http://127.0.0.1:54321
# La anon key la imprime `npx supabase status`.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# URL del backend (Nest). Por defecto local: http://localhost:3000
VITE_API_URL=

# Si es 'true', fuerza el uso de mocks en el cliente (para desarrollo sin backend)
VITE_USE_MOCKS=
