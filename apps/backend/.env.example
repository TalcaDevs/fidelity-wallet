# Conexión directa a Postgres que usa Prisma.
# Local (Supabase): postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Servidor y CORS
PORT=3000
BACKEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
ENABLE_SWAGGER=true

# Supabase
# La service_role key omite las políticas RLS: va SOLO en el backend, nunca en el frontend ni en el repositorio.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
# Opcional: origen público para las URLs del Storage (imágenes de la tarjeta). Google Wallet las
# descarga, así que deben ser HTTPS públicas. En local, la URL de un túnel al Vite (que hace proxy
# de /storage/v1), p. ej. https://xxxx.trycloudflare.com. Vacío: se usa SUPABASE_URL.
SUPABASE_PUBLIC_URL=

# Modo de desarrollo para pases sin certificados reales (permite emitir pases mock)
ALLOW_MOCK_PASSES=true

# Minutos que un pase queda bloqueado para sumar otro sello tras recibir uno (QR o manual). Por defecto 30.
# Acortarlo solo en pruebas locales (ej. 1).
STAMP_COOLDOWN_MINUTES=

# Máximo de sellos que el dueño puede cargar de una vez desde el escáner (con motivo). Por defecto 10.
OWNER_MAX_STAMPS_PER_LOAD=

# Clave para firmar el comprobante de validación del escáner (validar -> agregar sello).
# Vacía: se genera al arrancar y los comprobantes vigentes vencen con cada reinicio.
# Obligatoria en producción (NODE_ENV=production): sin ella el backend no arranca. Debe ser la misma
# en todas las instancias.
SCAN_VALIDATION_SECRET=

# Apple Wallet (Dev 1) — requiere cuenta Apple Developer
APPLE_PASS_TYPE_IDENTIFIER=pass.com.talcadevs.fidelity
APPLE_TEAM_IDENTIFIER=TALCADEVS1
APPLE_PASS_CERT=
APPLE_PASS_KEY=
APPLE_PASS_PASSWORD=
APPLE_WWDR_CERT=

# Google Wallet (Dev 1)
GOOGLE_WALLET_ISSUER_ID=3388000000022314567
GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=
GOOGLE_WALLET_PRIVATE_KEY=
