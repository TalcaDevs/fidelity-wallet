# Conexión directa a Postgres que usa Prisma.
# Local (Supabase): postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=

# Supabase
# La service_role key omite las políticas RLS: va SOLO en el backend, nunca en
# el frontend ni en el repositorio.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Apple Wallet (Dev 1) — requiere cuenta Apple Developer
APPLE_PASS_TYPE_ID=
APPLE_TEAM_ID=
APPLE_CERT_P12=
APPLE_CERT_PASSWORD=
APPLE_WWDR_CERT=

# Google Wallet (Dev 1)
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
