# Conexión directa a Postgres que usa Prisma.
# Local (Supabase): postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Servidor y CORS
PORT=3000
BACKEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
ENABLE_SWAGGER=true

# Supabase
# La service_role key omite las políticas RLS: va SOLO en el backend, nunca en el frontend ni en el repositorio.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# Modo de desarrollo para pases sin certificados reales (permite emitir pases mock)
ALLOW_MOCK_PASSES=true

# Minutos que un pase queda bloqueado para sumar otro sello tras recibir uno (QR o manual). Por defecto 30.
# Acortarlo solo en pruebas locales (ej. 1).
STAMP_COOLDOWN_MINUTES=

# Apple Wallet (Dev 1) — requiere cuenta Apple Developer
APPLE_PASS_TYPE_IDENTIFIER=pass.com.talcadevs.fidelity
APPLE_TEAM_IDENTIFIER=TALCADEVS1
APPLE_PASS_CERT=
APPLE_PASS_KEY=
APPLE_PASS_PASSWORD=
APPLE_WWDR_CERT=

# Google Wallet (Dev 1)
GOOGLE_WALLET_ISSUER_ID=3388000000022314567
GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=
GOOGLE_WALLET_PRIVATE_KEY=
