generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Merchant {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String
  email             String         @unique
  /// Identificador público de la landing /join/:slug. Estable: no cambia al renombrar el local.
  slug              String         @unique
  /// Vigencia de los sellos en dias. NULL = los sellos de este local no vencen.
  stampValidityDays Int?
  promotions        Promotion[]
  passes            Pass[]
  scans             Scan[]
  stamps            Stamp[]
  users             MerchantUser[]
  verificationCodes CustomerVerificationCode[]
  createdAt         DateTime       @default(now())
}

model MerchantUser {
  userId     String       @db.Uuid
  merchantId String       @db.Uuid
  merchant   Merchant     @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  role       MerchantRole @default(STAFF)
  createdAt  DateTime     @default(now())

  @@id([userId, merchantId])
  @@index([userId])
}

model Promotion {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId   String   @db.Uuid
  merchant     Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  name         String
  targetStamps Int
  rewardName   String
  isActive     Boolean  @default(true)
  stamps       Stamp[]
  /// Canjes de esta promoción (Scan REWARD_REDEEMED).
  scans        Scan[]
  createdAt    DateTime @default(now())
}

model Customer {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rut             String?   @unique
  phone           String?   @unique
  /// Última aceptación de los términos y condiciones (prueba del consentimiento, Ley 19.628).
  /// NULL en clientes registrados antes del 2026-09-24.
  termsAcceptedAt DateTime?
  /// Versión de los términos aceptada (ver TERMS_VERSION en customers/terms.ts).
  termsVersion    String?
  passes            Pass[]
  verificationCodes CustomerVerificationCode[]
  createdAt         DateTime  @default(now())

  @@index([rut])
  @@index([phone])
}

model Pass {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId String   @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  merchantId String   @db.Uuid
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  passToken  String   @unique
  scans      Scan[]
  stamps     Stamp[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([customerId, merchantId])
}

/// Fuente de verdad de los sellos. El saldo NO se guarda: se calcula al leer
/// contando las filas no consumidas y no vencidas (vista PassStampBalance).
model Stamp {
  id               String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  passId           String     @db.Uuid
  pass             Pass       @relation(fields: [passId], references: [id], onDelete: Cascade)
  merchantId       String     @db.Uuid
  merchant         Merchant   @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  promotionId      String?    @db.Uuid
  promotion        Promotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  earnedAt         DateTime   @default(now())
  /// Congelado al momento de sellar (earnedAt + stampValidityDays). No se recalcula.
  expiresAt        DateTime?
  consumedAt       DateTime?
  consumedByScanId String?    @db.Uuid
  sourceScanId     String?    @db.Uuid
  createdByUserId  String?    @db.Uuid

  @@index([passId, consumedAt, expiresAt])
  @@index([merchantId])
}

model Scan {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  passId          String     @db.Uuid
  pass            Pass       @relation(fields: [passId], references: [id], onDelete: Cascade)
  merchantId      String     @db.Uuid
  merchant        Merchant   @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  type            ScanType
  /// Solo en REWARD_REDEEMED: qué promoción eligió canjear el cliente. Los sellos son un saldo
  /// único del pase, así que un sello (STAMP_ADDED) no pertenece a ninguna promoción.
  promotionId     String?    @db.Uuid
  promotion       Promotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  /// Auditoria: que usuario (dueno o mesero) ejecuto el scan.
  createdByUserId String?    @db.Uuid
  method          ScanMethod @default(QR)
  createdAt       DateTime   @default(now())

  @@index([promotionId])
}

enum ScanType {
  STAMP_ADDED
  REWARD_REDEEMED
}

enum ScanMethod {
  QR
  MANUAL
}

enum MerchantRole {
  OWNER
  STAFF
}

/// Códigos OTP de un solo uso para verificar clientes y recuperar pases perdidos (SMS/WhatsApp).
model CustomerVerificationCode {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId String    @db.Uuid
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  merchantId String    @db.Uuid
  merchant   Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([customerId, merchantId, createdAt])
}
