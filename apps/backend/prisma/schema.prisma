generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// En toda marca migrada o que se registra sola, Brand.id = el id de su primer local.
model Brand {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  legalName     String?
  taxId         String?
  contactEmail  String?
  contactPhone  String?
  status        BrandStatus      @default(ACTIVE)
  /// Plan asignado a mano por el equipo interno hasta que exista cobro real (HANDOFF §6.5).
  planId        PlanId           @default(TRIAL)
  trialEndsAt   DateTime         @default(dbgenerated("(now() + '30 days'::interval)"))
  /// La tarjeta puede ser de puntos solo si está habilitado (lo deciden el OWNER y SUPERADMIN).
  pointsEnabled Boolean          @default(false)
  /// Pesos chilenos de compra por cada punto.
  pesosPerPoint Int              @default(1000)
  locations     Merchant[]
  programs      LoyaltyProgram[]
  members       BrandMember[]
  tickets       Ticket[]
  passes        Pass[]
  stamps        Stamp[]
  scans         Scan[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @default(now()) @updatedAt
}

/// Un LOCAL de una marca (HANDOFF §4.1: Merchant = Location).
model Merchant {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  brandId     String        @db.Uuid
  brand       Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  name        String
  email       String?       @unique
  /// Identificador público de la landing /join/:slug. Estable: no cambia al renombrar el local.
  slug        String        @unique
  address     String?
  commune     String?
  region      String?
  latitude    Float?
  longitude   Float?
  phone       String?
  contactName String?
  isActive    Boolean       @default(true)
  passes      Pass[]
  scans       Scan[]
  stamps      Stamp[]
  members     BrandMember[]
  tickets     Ticket[]
  createdAt   DateTime      @default(now())

  @@index([brandId])
}

model BrandMember {
  userId     String       @db.Uuid
  brandId    String       @db.Uuid
  brand      Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  role       MerchantRole @default(STAFF)
  /// Obligatorio para STAFF, NULL para OWNER (CHECK en la migración).
  merchantId String?      @db.Uuid
  merchant   Merchant?    @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  createdAt  DateTime     @default(now())

  @@id([userId, brandId])
  @@index([userId])
  @@index([merchantId])
}

/// La tarjeta de la marca: un programa por marca (UNIQUE brandId).
/// Con type POINTS cada fila de Stamp es un punto: el saldo, el vencimiento y el canje FIFO
/// funcionan igual que con sellos.
model LoyaltyProgram {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  brandId           String       @unique @db.Uuid
  brand             Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  /// Campo mantenido por retrocompatibilidad. Las reglas operativas ahora se rigen
  /// estrictamente por stampsEnabled y pointsEnabled.
  type              ProgramType  @default(STAMPS)
  stampsEnabled     Boolean      @default(true)
  pointsEnabled     Boolean      @default(false)
  allowMultipleRedemptionsPerVisit Boolean @default(false)
  /// LOCATION está reservado y no se implementa.
  scope             ProgramScope @default(BRAND)
  name              String
  /// Vigencia de los sellos (o puntos) en dias. NULL = no vencen.
  stampValidityDays Int?
  isActive          Boolean      @default(true)
  /// Sellos o puntos que recibe el cliente al obtener la tarjeta.
  welcomeBalance    Int          @default(0)
  /// Solo STAMPS: el STAFF suma a lo más un sello por día y cliente (hora de Chile).
  dailyStampLimit   Boolean      @default(true)
  cardValidity      CardValidity @default(UNLIMITED)
  /// Solo FIXED_DATE.
  cardExpiresAt     DateTime?
  /// Solo AFTER_JOIN.
  cardValidityDays  Int?
  /// CardDesign de @fidelity/shared (colores, ícono e imágenes).
  design            Json         @default("{}")
  /// CardDetails de @fidelity/shared (enlaces, secciones y datos visibles).
  details           Json         @default("{}")
  /// RegistrationConfig de @fidelity/shared (datos que pide /join).
  registration      Json         @default("{}")
  /// Sube con cada guardado: versiona las URLs de las imágenes que genera el backend.
  designVersion     Int          @default(1)
  promotions        Promotion[]
  passes            Pass[]
  stamps            Stamp[]
  scans             Scan[]
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @default(now()) @updatedAt

  @@index([brandId])
}

model Promotion {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  programId    String         @db.Uuid
  program      LoyaltyProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  name         String
  targetStamps Int
  currency     Currency       @default(STAMPS)
  rewardName   String
  isActive     Boolean        @default(true)
  stamps       Stamp[]
  /// Canjes de esta promoción (Scan REWARD_REDEEMED).
  scans        Scan[]
  createdAt    DateTime       @default(now())

  @@index([programId])
}

model Customer {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rut             String?   @unique
  phone           String?   @unique
  /// En minúsculas. El alta exige phone o email (lo aplica la API).
  email           String?   @unique
  /// Global: el mismo en todas las marcas. La caja solo ve el primer nombre.
  name            String?
  /// Cumpleaños: día y mes; el año es opcional (CHECK en la migración).
  birthDay        Int?      @db.SmallInt
  birthMonth      Int?      @db.SmallInt
  birthYear       Int?      @db.SmallInt
  /// Última aceptación de los términos y condiciones (prueba del consentimiento, Ley 19.628).
  /// NULL en clientes registrados antes del 2026-09-24.
  termsAcceptedAt DateTime?
  /// Versión de los términos aceptada (ver TERMS_VERSION en customers/terms.ts).
  termsVersion    String?
  passes          Pass[]
  createdAt       DateTime  @default(now())

  @@index([rut])
  @@index([phone])
  @@index([email])
}

model Pass {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId String         @db.Uuid
  customer   Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  programId  String         @db.Uuid
  program    LoyaltyProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  /// Lo fija el trigger pass_derive_brand desde programId.
  brandId    String         @db.Uuid
  brand      Brand          @relation(fields: [brandId], references: [id], onDelete: Cascade)
  /// Local donde el cliente se registró.
  merchantId String         @db.Uuid
  merchant   Merchant       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  passToken  String         @unique
  scans       Scan[]
  stamps      Stamp[]
  updateTasks PassUpdateTask[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([customerId, programId])
  @@index([brandId])
  @@index([merchantId])
}

/// Fuente de verdad de los sellos. El saldo NO se guarda: se calcula al leer
/// contando las filas no consumidas y no vencidas (vista PassStampBalance).
model Stamp {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  currency         Currency       @default(STAMPS)
  passId           String         @db.Uuid
  pass             Pass           @relation(fields: [passId], references: [id], onDelete: Cascade)
  /// brandId y programId los fija el trigger ledger_derive_from_pass desde passId.
  brandId          String         @db.Uuid
  brand            Brand          @relation(fields: [brandId], references: [id], onDelete: Cascade)
  programId        String         @db.Uuid
  program          LoyaltyProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  merchantId       String         @db.Uuid
  merchant         Merchant       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  promotionId      String?        @db.Uuid
  promotion        Promotion?     @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  earnedAt         DateTime       @default(now())
  /// Congelado al momento de sellar (earnedAt + stampValidityDays). No se recalcula.
  expiresAt        DateTime?
  consumedAt       DateTime?
  consumedByScanId String?        @db.Uuid
  sourceScanId     String?        @db.Uuid
  createdByUserId  String?        @db.Uuid

  @@index([passId, consumedAt, expiresAt])
  @@index([merchantId])
  @@index([brandId, earnedAt])
}

model Scan {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  passId          String         @db.Uuid
  pass            Pass           @relation(fields: [passId], references: [id], onDelete: Cascade)
  /// brandId y programId los fija el trigger ledger_derive_from_pass desde passId.
  brandId         String         @db.Uuid
  brand           Brand          @relation(fields: [brandId], references: [id], onDelete: Cascade)
  programId       String         @db.Uuid
  program         LoyaltyProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  merchantId      String         @db.Uuid
  merchant        Merchant       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  type            ScanType
  /// Solo en REWARD_REDEEMED: qué promoción eligió canjear el cliente. Los sellos son un saldo
  /// único del pase, así que un sello (STAMP_ADDED) no pertenece a ninguna promoción.
  promotionId     String?        @db.Uuid
  promotion       Promotion?     @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  /// Auditoria: que usuario (dueno o mesero) ejecuto el scan.
  createdByUserId String?        @db.Uuid
  method          ScanMethod     @default(QR)
  /// Sellos (o puntos) que sumó este scan. Sellos: 1 para el STAFF; el OWNER puede cargar varios
  /// (motivo en AuditLog). Puntos: los que da el monto de la compra.
  stampCount      Int            @default(1)
  /// Pesos chilenos. En una tarjeta de puntos define los puntos; en una de sellos solo se registra.
  purchaseAmount  Int?
  pointsEarned    Int            @default(0)
  note            String?
  receipt         ScanReceipt?
  createdAt       DateTime       @default(now())

  @@index([promotionId])
  @@index([brandId, createdAt])
  @@index([merchantId, createdAt])
}

/// Foto de la boleta en el bucket privado purchase-receipts. Va aparte de Scan porque el STAFF
/// lee Scan por RLS, y la foto solo la ven el OWNER y SUPERADMIN a través del backend.
model ScanReceipt {
  scanId           String   @id @db.Uuid
  scan             Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)
  storagePath      String   @unique
  mimeType         String
  sizeBytes        Int
  uploadedByUserId String   @db.Uuid
  createdAt        DateTime @default(now())
}

/// Se asigna solo por seed o SQL, nunca desde la UI. Sin grants para anon ni authenticated.
model PlatformAdmin {
  userId    String       @id @db.Uuid
  role      PlatformRole @default(SUPPORT)
  createdAt DateTime     @default(now())
}

/// Append-only.
model AuditLog {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId String         @db.Uuid
  actorType   AuditActorType
  action      String
  entity      String
  entityId    String?
  before      Json?
  after       Json?
  reason      String?
  createdAt   DateTime       @default(now())

  @@index([entity, entityId])
  @@index([actorUserId, createdAt])
}

/// Contrato en packages/shared (support.ts) y HANDOFF §11.4. Solo lo usa el backend: RLS sin
/// políticas y sin grants para anon ni authenticated.
model Ticket {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  number            Int                @unique @default(autoincrement())
  brandId           String             @db.Uuid
  brand             Brand              @relation(fields: [brandId], references: [id], onDelete: Cascade)
  /// Local sobre el que se consulta (opcional).
  merchantId        String?            @db.Uuid
  merchant          Merchant?          @relation(fields: [merchantId], references: [id], onDelete: SetNull)
  createdByUserId   String             @db.Uuid
  category          TicketCategory
  status            TicketStatus       @default(OPEN)
  priority          TicketPriority     @default(NORMAL)
  description       String
  contactPhone      String?
  assigneeUserId    String?            @db.Uuid
  lastMessageAt     DateTime           @default(now())
  /// Última respuesta pública del equipo: contra merchantReadAt define unreadForMerchant.
  lastPublicReplyAt DateTime?
  merchantReadAt    DateTime?
  resolvedAt        DateTime?
  closedAt          DateTime?
  messages          TicketMessage[]
  attachments       TicketAttachment[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @default(now()) @updatedAt

  @@index([brandId, createdAt])
  @@index([status, lastMessageAt])
  @@index([assigneeUserId])
}

model TicketMessage {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketId     String             @db.Uuid
  ticket       Ticket             @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorUserId String             @db.Uuid
  authorType   TicketAuthorType
  body         String
  /// Nota interna del equipo: nunca sale por los endpoints del dueño.
  isInternal   Boolean            @default(false)
  attachments  TicketAttachment[]
  createdAt    DateTime           @default(now())

  @@index([ticketId, createdAt])
}

/// Adjunto en el bucket privado support-attachments. messageId NULL = adjunto del alta.
model TicketAttachment {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketId         String         @db.Uuid
  ticket           Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  messageId        String?        @db.Uuid
  message          TicketMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  storagePath      String         @unique
  fileName         String
  mimeType         String
  sizeBytes        Int
  uploadedByUserId String         @db.Uuid
  createdAt        DateTime       @default(now())

  @@index([ticketId])
}

enum ScanType {
  STAMP_ADDED
  REWARD_REDEEMED
}

enum ScanMethod {
  QR
  MANUAL
  /// El dueño sumó sellos desde la ficha del cliente, sin escanear en caja.
  PANEL
  /// Saldo de bienvenida al obtener la tarjeta.
  WELCOME
}

enum MerchantRole {
  OWNER
  STAFF
}

enum BrandStatus {
  ACTIVE
  SUSPENDED
}

enum ProgramType {
  STAMPS
  POINTS
}

enum Currency {
  STAMPS
  POINTS
}

enum CardValidity {
  UNLIMITED
  FIXED_DATE
  AFTER_JOIN
}

enum ProgramScope {
  BRAND
  LOCATION
}

enum PlatformRole {
  SUPERADMIN
  SUPPORT
}

enum AuditActorType {
  PLATFORM
  OWNER
}

enum TicketCategory {
  SCANNER
  WALLET
  CUSTOMERS
  PROMOTIONS
  TEAM
  LOCATIONS
  BILLING
  ACCOUNT
  OTHER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_MERCHANT
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TicketAuthorType {
  MERCHANT
  PLATFORM
}

enum PlanId {
  TRIAL
  STARTER
  PRO
  BUSINESS
}

enum PassUpdateStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model PassUpdateTask {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  passId      String           @db.Uuid
  pass        Pass             @relation(fields: [passId], references: [id], onDelete: Cascade)
  status      PassUpdateStatus @default(PENDING)
  attempts    Int              @default(0)
  maxAttempts Int              @default(5)
  nextRetryAt DateTime         @default(now())
  lastError   String?
  lockedAt    DateTime?
  lockedBy    String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([status, nextRetryAt])
  @@index([passId])
}
